          </div>
          <div class="formRow">
            <div><label class="lbl">Téléphone</label><input name="phone" placeholder="+33 ..."></div>
            <div><label class="lbl">Ville</label><input name="city" required placeholder="Paris / Lyon ..."></div>
          </div>
          <label class="lbl">Forfait</label>
          <select name="project">
            <option>Démarrage rapide.</option>
            <option>Standard Business.</option>
            <option>Résultat maximal.</option>
          </select>
          <label class="lbl">Message</label>
          <textarea name="message" rows="5" required
            placeholder="Exemple : j’ai un detailing à Nice — je veux une page d’atterrissage pour les réservations de polissage."></textarea>
          <div class="formActions mt-12">
            <button class="btn btnP" type="submit">Envoyer</button>
          </div>
          <div id="formStatus" class="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>

  <footer class="c" style="padding:18px 20px;color:gray">
    <p>© <span id="y"></span> VVZ Studio · <a href="html-sitemap.html">Plan HTML du site</a></p>
  </footer>

